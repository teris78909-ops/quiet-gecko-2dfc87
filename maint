
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GeoMeasure GPS PRO</title>

<link rel="stylesheet"
href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

<style>
:root {
  --bg:#0b1220;
  --panel:#131e30;
  --line:#26364c;
  --green:#19d69b;
  --blue:#3998ff;
  --text:#edf4ff;
  --muted:#91a2b9;
  --red:#ff626f;
}
* {box-sizing:border-box}
body {
  margin:0;
  background:var(--bg);
  color:var(--text);
  font-family:Arial,sans-serif;
}
header {
  padding:17px;
  background:#101a2b;
  border-bottom:1px solid var(--line);
}
h1 {font-size:20px;margin:0}
header p {color:var(--muted);font-size:12px;margin:6px 0 0}
main {padding:12px;max-width:900px;margin:auto}
.panel {
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:13px;
  padding:13px;
  margin-bottom:12px;
}
.status {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  flex-wrap:wrap;
}
.pill {
  background:#26364c;
  padding:7px 10px;
  border-radius:20px;
  font-size:12px;
}
.good {color:var(--green)}
.warn {color:#ffbd58}
.bad {color:var(--red)}
#map {
  width:100%;
  height:370px;
  border-radius:12px;
  overflow:hidden;
  z-index:1;
}
.metrics {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:9px;
}
.metric {
  background:#0d1727;
  border:1px solid var(--line);
  border-radius:10px;
  padding:12px;
}
.metric small {color:var(--muted)}
.metric strong {
  display:block;
  font-size:20px;
  margin-top:7px;
  overflow-wrap:anywhere;
}
.buttons {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}
button {
  border:0;
  border-radius:9px;
  padding:12px 8px;
  color:white;
  font-weight:bold;
  background:#26364c;
  cursor:pointer;
}
button:active {opacity:.7}
.primary {background:#087d60}
.blue {background:#1769b5}
.danger {background:#8c2937}
button:disabled {opacity:.4}
.info {
  font-size:12px;
  color:var(--muted);
  line-height:1.6;
}
#gpsDetails {
  font-size:12px;
  line-height:1.8;
  color:var(--muted);
}
.bar {
  height:7px;
  background:#26364c;
  border-radius:10px;
  overflow:hidden;
  margin-top:9px;
}
#qualityBar {
  width:0%;
  height:100%;
  background:var(--green);
  transition:width .3s;
}
footer {
  text-align:center;
  color:var(--muted);
  padding:15px;
  font-size:11px;
}
</style>
</head>

<body>

<header>
  <h1>📡 GeoMeasure GPS PRO</h1>
  <p>Medidor geográfico • GPS em tempo real • Área e perímetro</p>
</header>

<main>

<section class="panel">
  <div class="status">
    <strong>Estado do GPS</strong>
    <span id="gpsStatus" class="pill warn">Aguardando GPS</span>
  </div>

  <div style="margin-top:14px">
    <div class="status">
      <span class="info">Precisão estimada</span>
      <strong id="accuracy">-- m</strong>
    </div>
    <div class="bar">
      <div id="qualityBar"></div>
    </div>
  </div>

  <div id="gpsDetails" style="margin-top:10px">
    Satélites e coordenadas aguardando leitura do dispositivo.
  </div>
</section>

<section class="panel">
  <div id="map"></div>
  <p class="info">
    Toque no mapa para adicionar um ponto manualmente.
    Use o GPS PRO para registrar sua posição estabilizada.
  </p>
</section>

<section class="panel">
  <div class="metrics">
    <div class="metric">
      <small>Área</small>
      <strong id="area">0 m²</strong>
    </div>
    <div class="metric">
      <small>Perímetro</small>
      <strong id="perimeter">0 m</strong>
    </div>
    <div class="metric">
      <small>Hectares</small>
      <strong id="hectares">0 ha</strong>
    </div>
    <div class="metric">
      <small>Pontos registrados</small>
      <strong id="pointCount">0</strong>
    </div>
  </div>
</section>

<section class="panel">
  <strong>Controles GPS PRO</strong>
  <p class="info">
    Aguarde pelo menos 5 leituras válidas para calcular a posição
    estabilizada. A média ponderada reduz oscilações, mas não
    garante a posição verdadeira.
  </p>

  <div class="buttons">
    <button class="primary" id="startGPS">▶ Iniciar GPS</button>
    <button class="danger" id="stopGPS">■ Parar GPS</button>
    <button class="blue" id="addGPS">📍 Registrar ponto GPS</button>
    <button id="closePolygon">🔒 Fechar perímetro</button>
    <button id="undo">↩ Desfazer ponto</button>
    <button id="clear">🗑 Limpar tudo</button>
    <button id="export" class="primary">⬇ Exportar CSV</button>
  </div>
</section>

<section class="panel">
  <strong>Diagnóstico técnico</strong>
  <div id="diagnostics" class="info" style="margin-top:10px">
    Aguardando inicialização...
  </div>
</section>

</main>

<footer>
GeoMeasure GPS PRO • Desenvolvido para medições geográficas
</footer>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
"use strict";

// =====================================
// CONFIGURAÇÃO
// =====================================

const CONFIG = {
  MAX_ACCURACY: 15,
  MIN_READINGS: 5,
  MAX_SAMPLES: 12,
  MAX_AGE: 12000,
  MAX_SPREAD: 15,
  MIN_DISTANCE: 1.5
};

// =====================================
// VARIÁVEIS
// =====================================

let map;
let watchId = null;
let samples = [];
let stablePosition = null;
let currentAccuracy = Infinity;
let points = [];
let markers = [];
let polygon = null;
let gpsMarker = null;
let accuracyCircle = null;

// =====================================
// MAPA
// =====================================

map = L.map("map").setView([-12.9714, -38.5014], 12);

L.tileLayer(
  "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
  {
    maxZoom: 20,
    attribution: "&copy; OpenStreetMap"
  }
).addTo(map);

map.on("click", event => {
  addPoint(
    event.latlng.lat,
    event.latlng.lng,
    "Manual"
  );
});

// =====================================
// DISTÂNCIA ENTRE COORDENADAS
// =====================================

function distance(lat1, lon1, lat2, lon2) {
  const R = 6371000;
  const rad = Math.PI / 180;

  const dLat = (lat2-lat1)*rad;
  const dLon = (lon2-lon1)*rad;

  const a =
    Math.sin(dLat/2)**2 +
    Math.cos(lat1*rad) *
    Math.cos(lat2*rad) *
    Math.sin(dLon/2)**2;

  return 2*R*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
}

// =====================================
// GPS
// =====================================

function startGPS() {
  if (!navigator.geolocation) {
    alert("Seu navegador não oferece suporte ao GPS.");
    return;
  }

  if (watchId !== null) return;

  samples = [];
  stablePosition = null;

  setStatus("Procurando sinal...", "warn");

  watchId = navigator.geolocation.watchPosition(
    onGPS,
    onGPSError,
    {
      enableHighAccuracy: true,
      maximumAge: 0,
      timeout: 25000
    }
  );
}

function stopGPS() {
  if (watchId !== null) {
    navigator.geolocation.clearWatch(watchId);
    watchId = null;
  }

  setStatus("GPS parado", "warn");
}

function onGPS(position) {
  const c = position.coords;

  const sample = {
    lat: c.latitude,
    lng: c.longitude,
    accuracy: c.accuracy,
    time: Date.now()
  };

  currentAccuracy = sample.accuracy;

  // Não usar leituras excessivamente imprecisas.
  if (
    !Number.isFinite(sample.accuracy) ||
    sample.accuracy > CONFIG.MAX_ACCURACY
  ) {
    updateDisplay();
    setStatus("Precisão insuficiente", "bad");
    return;
  }

  samples.push(sample);

  if (samples.length > CONFIG.MAX_SAMPLES) {
    samples.shift();
  }

  calculateStablePosition();
  updateDisplay();
}

function calculateStablePosition() {
  if (samples.length < CONFIG.MIN_READINGS) {
    stablePosition = null;
    setStatus(
      "Coletando leituras " +
      samples.length + "/" + CONFIG.MIN_READINGS,
      "warn"
    );
    return;
  }

  const now = Date.now();

  const valid = samples.filter(s =>
    now-s.time <= CONFIG.MAX_AGE &&
    s.accuracy <= CONFIG.MAX_ACCURACY
  );

  if (valid.length < CONFIG.MIN_READINGS) {
    stablePosition = null;
    setStatus("Aguardando leituras recentes", "warn");
    return;
  }

  // Média ponderada pela precisão estimada.
  let totalWeight = 0;
  let lat = 0;
  let lng = 0;

  valid.forEach(s => {
    const weight = 1 / Math.max(s.accuracy, 1)**2;

    totalWeight += weight;
    lat += s.lat * weight;
    lng += s.lng * weight;
  });

  lat /= totalWeight;
  lng /= totalWeight;

  // Verifica dispersão das coordenadas.
  const distances = valid.map(s =>
    distance(lat, lng, s.lat, s.lng)
  );

  const spread = Math.max(...distances);

  const estimatedAccuracy =
    Math.sqrt(1 / totalWeight);

  const allowedSpread = Math.max(
    CONFIG.MAX_SPREAD,
    estimatedAccuracy * 1.5
  );

  if (spread > allowedSpread) {
    stablePosition = null;
    setStatus("Posição oscilando", "warn");
    return;
  }

  stablePosition = {
    lat,
    lng,
    accuracy: estimatedAccuracy,
    spread,
    readings: valid.length
  };

  setStatus("GPS estabilizado", "good");

  updateGPSMarker();
}

function onGPSError(error) {
  const messages = {
    1: "Permissão de localização negada",
    2: "Localização indisponível",
    3: "Tempo de espera esgotado"
  };

  setStatus(
    messages[error.code] || "Erro de GPS",
    "bad"
  );
}

function setStatus(message, type) {
  const el = document.getElementById("gpsStatus");

  el.textContent = message;
  el.className = "pill " + type;
}

// =====================================
// INTERFACE GPS
// =====================================

function updateDisplay() {
  document.getElementById("accuracy").textContent =
    Number.isFinite(currentAccuracy)
      ? "±" + currentAccuracy.toFixed(1) + " m"
      : "-- m";

  let quality = Math.max(
    0,
    Math.min(100, 100-currentAccuracy*3)
  );

  document.getElementById("qualityBar").style.width =
    quality + "%";

  document.getElementById("gpsDetails").innerHTML =
    "Leituras armazenadas: " + samples.length +
    "<br>Precisão da última leitura: ±" +
    (Number.isFinite(currentAccuracy)
      ? currentAccuracy.toFixed(1) : "--") + " m" +
    "<br>Posição estabilizada: " +
    (stablePosition ? "SIM" : "NÃO");

  document.getElementById("diagnostics").innerHTML =
    "Latitude: " +
    (stablePosition ? stablePosition.lat.toFixed(7) : "--") +
    "<br>Longitude: " +
    (stablePosition ? stablePosition.lng.toFixed(7) : "--") +
    "<br>Dispersão: " +
    (stablePosition ? stablePosition.spread.toFixed(2)+" m" : "--") +
    "<br>Leituras válidas: " +
    (stablePosition ? stablePosition.readings : 0);
}

function updateGPSMarker() {
  if (!stablePosition) return;

  const p = stablePosition;

  if (!gpsMarker) {
    gpsMarker = L.circleMarker(
      [p.lat,p.lng],
      {
        radius:7,
        color:"#ffffff",
        weight:2,
        fillColor:"#19d69b",
        fillOpacity:1
      }
    ).addTo(map);

    accuracyCircle = L.circle(
      [p.lat,p.lng],
      {
        radius:Math.max(p.accuracy,1),
        color:"#19d69b",
        fillOpacity:0.08,
        weight:1
      }
    ).addTo(map);
  } else {
    gpsMarker.setLatLng([p.lat,p.lng]);

    accuracyCircle.setLatLng([p.lat,p.lng]);
    accuracyCircle.setRadius(Math.max(p.accuracy,1));
  }
}

// =====================================
// REGISTRO DE PONTOS
// =====================================

function addPoint(lat,lng,source) {
  if (points.length > 0) {
    const last = points[points.length-1];

    if (
      distance(last.lat,last.lng,lat,lng) <
      CONFIG.MIN_DISTANCE
    ) {
      alert("Ponto muito próximo do anterior.");
      return;
    }
  }

  const point = {
    lat,
    lng,
    source,
    createdAt:new Date().toISOString()
  };

  points.push(point);

  const marker = L.marker([lat,lng])
    .addTo(map)
    .bindPopup(
      "Ponto " + points.length +
      "<br>Origem: " + source
    );

  markers.push(marker);

  updateMeasurement();
  updateDisplay();
}

function registerGPSPoint() {
  if (!stablePosition) {
    alert(
      "GPS ainda não estabilizou. Aguarde novas leituras."
    );
    return;
  }

  const p = stablePosition;

  addPoint(
    p.lat,
    p.lng,
    "GPS PRO"
  );
}

// =====================================
// ÁREA E PERÍMETRO
// =====================================

function haversine(a,b) {
  return distance(a.lat,a.lng,b.lat,b.lng);
}

function calculateArea(coords) {
  if (coords.length < 3) return 0;

  const R = 6378137;
  const lat0 =
    coords.reduce((sum,p)=>sum+p.lat,0) /
    coords.length;

  const rad = Math.PI/180;

  const xy = coords.map(p => ({
    x:R*p.lng*rad*Math.cos(lat0*rad),
    y:R*p.lat*rad
  }));

  let sum = 0;

  for(let i=0;i<xy.length;i++) {
    const j=(i+1)%xy.length;

    sum += xy[i].x*xy[j].y -
           xy[j].x*xy[i].y;
  }

  return Math.abs(sum/2);
}

function calculatePerimeter(coords) {
  if(coords.length < 2) return 0;

  let total=0;

  for(let i=0;i<coords.length;i++) {
    const j=(i+1)%coords.length;
    total += haversine(coords[i],coords[j]);
  }

  return total;
}

function updateMeasurement() {
  const area = calculateArea(points);
  const perimeter =
    points.length >= 3
      ? calculatePerimeter(points)
      : points.length >= 2
        ? points.slice(1).reduce(
            (sum,p,i) =>
              sum+haversine(points[i],p),0
          )
        : 0;

  document.getElementById("area").textContent =
    formatNumber(area)+" m²";

  document.getElementById("hectares").textContent =
    formatNumber(area/10000)+" ha";

  document.getElementById("perimeter").textContent =
    formatNumber(perimeter)+" m";

  document.getElementById("pointCount").textContent =
    points.length;

  if(polygon) {
    map.removeLayer(polygon);
    polygon=null;
  }

  if(points.length>=2) {
    polygon=L.polyline(
      points.map(p=>[p.lat,p.lng]),
      {
        color:"#19d69b",
        weight:3,
        dashArray:"7 5"
      }
    ).addTo(map);
  }
}

function formatNumber(value) {
  return value.toLocaleString("pt-BR",{
    maximumFractionDigits:2
  });
}

// =====================================
// FECHAR E EDITAR
// =====================================

function closePolygon() {
  if(points.length<3) {
    alert("São necessários pelo menos 3 pontos.");
    return;
  }

  if(polygon) map.removeLayer(polygon);

  polygon=L.polygon(
    points.map(p=>[p.lat,p.lng]),
    {
      color:"#19d69b",
      fillColor:"#19d69b",
      fillOpacity:0.15,
      weight:3
    }
  ).addTo(map);

  map.fitBounds(polygon.getBounds());

  updateMeasurement();
}

function undoPoint() {
  if(!points.length) return;

  points.pop();

  const marker=markers.pop();

  if(marker) map.removeLayer(marker);

  if(polygon) {
    map.removeLayer(polygon);
    polygon=null;
  }

  updateMeasurement();
}

function clearAll() {
  if(!confirm("Apagar todos os pontos e medições?")) {
    return;
  }

  points=[];
  markers.forEach(m=>map.removeLayer(m));
  markers=[];

  if(polygon) map.removeLayer(polygon);
  polygon=null;

  updateMeasurement();
}

// =====================================
// EXPORTAR CSV
// =====================================

function exportCSV() {
  if(!points.length) {
    alert("Não existem pontos para exportar.");
    return;
  }

  let csv =
    "Ponto;Latitude;Longitude;Origem;Data\n";

  points.forEach((p,i)=>{
    csv += [
      i+1,
      p.lat,
      p.lng,
      p.source,
      p.createdAt
    ].join(";")+"\n";
  });

  const blob = new Blob(
    ["\uFEFF"+csv],
    {type:"text/csv;charset=utf-8"}
  );

  const url=URL.createObjectURL(blob);
  const a=document.createElement("a");

  a.href=url;
  a.download="geomeasure-medicao.csv";
  a.click();

  URL.revokeObjectURL(url);
}

// =====================================
// EVENTOS
// =====================================

document.getElementById("startGPS")
  .addEventListener("click",startGPS);

document.getElementById("stopGPS")
  .addEventListener("click",stopGPS);

document.getElementById("addGPS")
  .addEventListener("click",registerGPSPoint);

document.getElementById("closePolygon")
  .addEventListener("click",closePolygon);

document.getElementById("undo")
  .addEventListener("click",undoPoint);

document.getElementById("clear")
  .addEventListener("click",clearAll);

document.getElementById("export")
  .addEventListener("click",exportCSV);

// Inicialização
updateMeasurement();
updateDisplay();

</script>
</body>
</html>
